# Copy this file to .env and fill in real values. Never commit .env.

# Required. Get a key at https://console.groq.com/keys
# NOTE: evaluation/production use should use a key/plan with sufficient
# token quota -- the free tier's daily token limit (TPD) can be
# exhausted during a single run against a full 5-7 article newsletter,
# which triggers the safe deterministic fallback described in the
# README rather than a crash, but reduces how many summaries are
# LLM-grounded.
GROQ_API_KEY=your_groq_api_key_here

# Optional. Overrides the default Groq model (openai/gpt-oss-20b).
# See tools/llm_utils.py.
GROQ_MODEL=openai/gpt-oss-20b
